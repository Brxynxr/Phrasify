# ==============================================================================
# CONFIGURACIÓN DE IA PARA EL PROYECTO RESONANCIA (TRIBUNA)
# ==============================================================================

# Proveedor del modelo generador. Opciones soportadas: 'gemini' o 'ollama'
PROVEEDOR_IA=gemini

# ------------------------------------------------------------------------------
# Configuración para Google Gemini API (Recomendado)
# Consigue tu clave de API gratis en: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# ------------------------------------------------------------------------------
# Configuración para Ollama (Ejecución local en tu máquina)
# Descárgalo gratis en: https://ollama.com/
# ------------------------------------------------------------------------------
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
